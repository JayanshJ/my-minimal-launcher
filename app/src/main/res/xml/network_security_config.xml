<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal Launcher — Network Security Configuration
    All traffic is HTTPS only. No cleartext (HTTP) is permitted.
    This is the default behaviour for API 29+, but declaring it explicitly
    satisfies Play Store reviewers and makes the intent clear.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust the system CAs (standard certificate authorities) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
