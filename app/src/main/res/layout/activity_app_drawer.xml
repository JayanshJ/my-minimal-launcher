<?xml version="1.0" encoding="utf-8"?>
<!--
    App drawer: slides up from the bottom of the home screen.
    Sections (top → bottom):
      1. Close handle (tap or swipe down)
      2. Search bar (underline-only, auto-focused)
      3. "Search the web for …" ghost row (visible while typing)
      4. FrameLayout: full app list (RecyclerView) + AlphabetIndexView overlay
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ───────────────── Close handle ───────────────── -->
    <TextView
        android:id="@+id/tv_close_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:text="↓"
        android:textColor="#555555"
        android:textSize="18sp" />

    <!-- ───────────────── Search bar ───────────────── -->
    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_h"
        android:layout_marginEnd="@dimen/margin_h"
        android:layout_marginTop="4dp"
        android:background="@null"
        android:fontFamily="sans-serif-light"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:inputType="text"
        android:maxLines="1"
        android:paddingBottom="10dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="@color/gray_hint"
        android:textCursorDrawable="@null"
        android:textSize="@dimen/search_text_size" />

    <!-- Underline for search field -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/margin_h"
        android:layout_marginEnd="@dimen/margin_h"
        android:alpha="0.25"
        android:background="@color/white" />

    <!-- ───────────────── Web-search ghost row ───────────────── -->
    <TextView
        android:id="@+id/tv_web_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_h"
        android:layout_marginEnd="@dimen/margin_h"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.01"
        android:paddingTop="14dp"
        android:paddingBottom="4dp"
        android:textColor="@color/gray_secondary"
        android:textSize="@dimen/web_search_text_size"
        android:visibility="gone" />

    <!-- ───────────────── App list + Alphabet index ───────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="10dp"
            android:paddingEnd="36dp"
            android:paddingBottom="32dp"
            android:scrollbars="none" />

        <com.minimal.launcher.AlphabetIndexView
            android:id="@+id/alphabet_index"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:layout_gravity="end" />

    </FrameLayout>


</LinearLayout>
