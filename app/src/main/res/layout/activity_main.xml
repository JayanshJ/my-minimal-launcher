<?xml version="1.0" encoding="utf-8"?>
<!--
    Root is a FrameLayout so the spotlight tour overlay can sit on top of all content.
    The inner LinearLayout (home_content) holds the actual home screen views.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ═══════════════════ HOME SCREEN CONTENT ═══════════════════ -->
    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <!-- ───────────────── Greeting ───────────────── -->
        <TextView
            android:id="@+id/tv_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_h"
            android:layout_marginTop="@dimen/clock_margin_top"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.04"
            android:textColor="@color/gray_secondary"
            android:textSize="14sp" />

        <!-- ───────────────── Clock ───────────────── -->
        <TextView
            android:id="@+id/tv_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_h"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-thin"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="@dimen/clock_text_size" />

        <!-- ───────────────── Date ───────────────── -->
        <TextView
            android:id="@+id/tv_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_h"
            android:layout_marginEnd="@dimen/margin_h"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.06"
            android:text="Monday, 1 January"
            android:textColor="@color/gray_secondary"
            android:textSize="@dimen/date_text_size" />

        <!-- ───────────────── Info widget ───────────────── -->
        <TextView
            android:id="@+id/tv_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_h"
            android:layout_marginEnd="@dimen/margin_h"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-light"
            android:lineSpacingExtra="7dp"
            android:textColor="@color/gray_secondary"
            android:textSize="@dimen/widget_text_size" />

        <!-- ───────────────── Pomodoro timer ───────────────── -->
        <TextView
            android:id="@+id/tv_timer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_h"
            android:layout_marginTop="22dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:text="25:00"
            android:textColor="@color/gray_secondary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tv_timer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_h"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.04"
            android:text="focus  ·  tap to start"
            android:textColor="@color/gray_secondary"
            android:textSize="12sp" />

        <!-- Focus action button -->
        <TextView
            android:id="@+id/tv_focus_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_h"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.06"
            android:text="start focus →"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <!-- ───────────────── Divider ───────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/margin_h"
            android:layout_marginEnd="@dimen/margin_h"
            android:layout_marginTop="24dp"
            android:background="@color/divider" />

        <!-- ───────────────── Home apps ───────────────── -->
        <FrameLayout
            android:id="@+id/home_apps_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_home_apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="4dp"
                android:paddingBottom="32dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tv_empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="8dp"
                android:text="swipe up to open the app drawer&#10;long-press any app to pin it here"
                android:textColor="#666666"
                android:textSize="13sp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- ───────────────── Drawer hint ───────────────── -->
        <TextView
            android:id="@+id/tv_drawer_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:text="↑"
            android:textColor="#555555"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- ═══════════════════ SPOTLIGHT TOUR OVERLAY ═══════════════════ -->
    <!--
        Sits on top of home content. Invisible until the first-launch tour starts.
        SpotlightView draws the dim overlay + cutout; tooltip text sits below/above the spotlight.
    -->
    <FrameLayout
        android:id="@+id/tour_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Dark overlay with rounded-rect cutout -->
        <com.minimal.launcher.SpotlightView
            android:id="@+id/spotlight_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Tooltip — gravity toggled programmatically (top or bottom) -->
        <LinearLayout
            android:id="@+id/tour_tooltip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="36dp"
            android:paddingBottom="56dp">

            <TextView
                android:id="@+id/tour_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textColor="@color/white"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/tour_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.01"
                android:lineSpacingMultiplier="1.55"
                android:textColor="#AAAAAA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tour_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.04"
                android:textColor="#555555"
                android:textSize="13sp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
