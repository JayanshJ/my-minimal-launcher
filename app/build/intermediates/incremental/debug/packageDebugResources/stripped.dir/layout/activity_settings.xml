<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings screen — pure text, same black/white aesthetic.
    Active options are white; inactive options are #555555.
    Sections are separated by very subtle 1dp dividers.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_h"
        android:paddingEnd="@dimen/margin_h"
        android:paddingTop="56dp"
        android:paddingBottom="48dp">

        <!-- ── Page title ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.02"
            android:text="settings"
            android:textColor="@color/white"
            android:textSize="36sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-light"
            android:text="long-press clock to return"
            android:textColor="@color/gray_secondary"
            android:textSize="12sp" />

        <!-- ══════════ DISPLAY ══════════ -->
        <TextView
            style="@style/SectionHeader"
            android:layout_marginTop="36dp"
            android:text="display" />

        <!-- Clock format -->
        <TextView style="@style/SettingLabel" android:text="clock format" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:id="@+id/opt_24h"   style="@style/SettingOption" android:text="24h" />
            <TextView style="@style/SettingDot" android:text="  ·  " />
            <TextView android:id="@+id/opt_12h"   style="@style/SettingOption" android:text="12h" />
        </LinearLayout>

        <View style="@style/Divider" />

        <!-- App list display -->
        <TextView style="@style/SettingLabel" android:text="app list" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:id="@+id/opt_list" style="@style/SettingOption" android:text="list" />
            <TextView style="@style/SettingDot"  android:text="  ·  " />
            <TextView android:id="@+id/opt_grid" style="@style/SettingOption" android:text="grid" />
        </LinearLayout>

        <View style="@style/Divider" />

        <!-- Font size -->
        <TextView style="@style/SettingLabel" android:text="font size" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:id="@+id/opt_font_small"  style="@style/SettingOption" android:text="small" />
            <TextView style="@style/SettingDot" android:text="  ·  " />
            <TextView android:id="@+id/opt_font_medium" style="@style/SettingOption" android:text="medium" />
            <TextView style="@style/SettingDot" android:text="  ·  " />
            <TextView android:id="@+id/opt_font_large"  style="@style/SettingOption" android:text="large" />
        </LinearLayout>

        <!-- Timer visibility -->
        <TextView style="@style/SettingLabel" android:text="pomodoro timer" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:id="@+id/opt_timer_show" style="@style/SettingOption" android:text="show" />
            <TextView style="@style/SettingDot" android:text="  ·  " />
            <TextView android:id="@+id/opt_timer_hide" style="@style/SettingOption" android:text="hide" />
        </LinearLayout>

        <!-- Drawer keyboard -->
        <TextView style="@style/SettingLabel" android:text="drawer keyboard" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:id="@+id/opt_keyboard_on"  style="@style/SettingOption" android:text="on" />
            <TextView style="@style/SettingDot" android:text="  ·  " />
            <TextView android:id="@+id/opt_keyboard_off" style="@style/SettingOption" android:text="off" />
        </LinearLayout>

        <View style="@style/Divider" />

        <!-- Temperature unit -->
        <TextView style="@style/SettingLabel" android:text="temperature" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:id="@+id/opt_celsius"    style="@style/SettingOption" android:text="°C" />
            <TextView style="@style/SettingDot" android:text="  ·  " />
            <TextView android:id="@+id/opt_fahrenheit" style="@style/SettingOption" android:text="°F" />
        </LinearLayout>

        <!-- ══════════ GESTURES ══════════ -->
        <TextView
            style="@style/SectionHeader"
            android:layout_marginTop="28dp"
            android:text="gestures" />

        <!-- Swipe left -->
        <TextView style="@style/SettingLabel" android:text="swipe left" />
        <TextView
            android:id="@+id/opt_gesture_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-light"
            android:text="none"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <View style="@style/Divider" />

        <!-- Swipe right -->
        <TextView style="@style/SettingLabel" android:text="swipe right" />
        <TextView
            android:id="@+id/opt_gesture_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-light"
            android:text="none"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <!-- ══════════ HIDDEN APPS ══════════ -->
        <TextView
            style="@style/SectionHeader"
            android:layout_marginTop="28dp"
            android:text="hidden apps" />

        <!-- Populated dynamically at runtime -->
        <LinearLayout
            android:id="@+id/ll_hidden_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/btn_hide_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-light"
            android:text="hide an app..."
            android:textColor="@color/gray_secondary"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
