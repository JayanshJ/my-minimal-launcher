<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal Launcher — adaptive icon foreground.
    108×108dp canvas · safe zone 72×72dp (18dp inset all sides).

    Design: a silhouette of the home screen itself —
    a wide clock bar, a medium date bar, then two short app rows.
    Left-aligned, exactly like the real screen. Instantly recognisable
    and totally unique in the launcher category.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Clock bar — widest, thickest, pure white -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22,32 L86,32 Q88,32 88,35.5 L88,42.5 Q88,46 86,46 L22,46 Q20,46 20,42.5 L20,35.5 Q20,32 22,32 Z" />

    <!-- Date bar — medium width, thinner, soft white -->
    <path
        android:fillColor="#AAAAAA"
        android:pathData="M22,52 L65,52 Q67,52 67,54.5 L67,57.5 Q67,60 65,60 L22,60 Q20,60 20,57.5 L20,54.5 Q20,52 22,52 Z" />

    <!-- App row 1 — narrower, white -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22,67 L55,67 Q57,67 57,69.5 L57,72.5 Q57,75 55,75 L22,75 Q20,75 20,72.5 L20,69.5 Q20,67 22,67 Z" />

    <!-- App row 2 — shortest, slightly dimmer -->
    <path
        android:fillColor="#777777"
        android:pathData="M22,81 L46,81 Q48,81 48,83.5 L48,86.5 Q48,89 46,89 L22,89 Q20,89 20,86.5 L20,83.5 Q20,81 22,81 Z" />

</vector>
